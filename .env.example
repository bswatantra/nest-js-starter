# Application
PORT=3000
CACHE_TTL_MS=5000
# CLUSTER_WORKERS=4

# Security — CORS: comma-separated list of allowed origins; leave unset to block all cross-origin requests
# ALLOWED_ORIGINS=http://localhost:5173,https://myapp.com

# Security — Rate Limiting: max THROTTLE_LIMIT requests per THROTTLE_TTL_MS milliseconds per IP
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Logging Channel: stderr (terminal only) | file (file only) | stack (both stderr and file)
LOG_CHANNEL=stderr
LOG_FILE=logs/app.log
LOG_ERROR_FILE=logs/error.log

# Active Database Driver: sqlite | mysql | postgresql
DB_CONNECTION=sqlite

# Common Database Credentials (used when DB_CONNECTION is mysql or postgresql)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nest_learning
DB_SCHEMA=public
# DB_POOL_SIZE=10
# DB_POOL_TIMEOUT=10

# SQLite Configuration
SQLITE_DATABASE_PATH=./dev.db

# Optional: Direct Connection URLs (overrides individual host/port settings if set)
DATABASE_URL="file:./dev.db"
# MYSQL_DATABASE_URL="mysql://root:password@127.0.0.1:3306/nest_learning"
# POSTGRESQL_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nest_learning?schema=public"

# NestJS Observe Credentials
OBSERVE_APP_KEY=your_observe_app_key
OBSERVE_APP_SECRET=your_observe_app_secret
